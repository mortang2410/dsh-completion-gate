{
  "name": "dsh-completion-gate",
  "version": "0.1.3",
  "description": "Evidence-backed production-readiness completion barrier for DeepSeek Harness with persistent operator-configurable control center.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./runner": "./lib/runner.js",
    "./client": "./lib/client.js",
    "./changes": "./lib/changes.js",
    "./ledger": "./lib/ledger.js",
    "./recipe": "./lib/recipe.js",
    "./recipe-runner": "./lib/recipe-runner.js",
    "./verification": "./lib/verification.js",
    "./package.json": "./package.json",
    "./settings": "./lib/settings.js"
  },
  "files": [
    "lib",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/core.js && node --check lib/runner.js && node --check lib/settings.js && node --check lib/client.js && node --check lib/changes.js && node --check lib/ledger.js && node --check lib/recipe.js && node --check lib/recipe-runner.js && node --check lib/verification.js",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "completion-gate",
    "production-readiness",
    "quality-gate",
    "agent"
  ],
  "license": "MIT",
  "author": "AGSQ11"
}
