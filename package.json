{
  "name": "dsh-completion-gate",
  "version": "0.3.0",
  "description": "Advisory multi-repository completion tracker for DeepSeek Harness: attributes each changed file to its repository and names unfinished work at the stop.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./changes": "./lib/changes.js",
    "./settings": "./lib/settings.js",
    "./report": "./lib/report.js",
    "./repositories": "./lib/repositories.js",
    "./tracker": "./lib/tracker.js",
    "./catalog": "./lib/catalog.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/catalog.js && node --check lib/changes.js && node --check lib/client.js && node --check lib/core.js && node --check lib/index.js && node --check lib/report.js && node --check lib/repositories.js && node --check lib/settings.js && node --check lib/tracker.js",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "completion-gate",
    "completion-tracker",
    "advisory",
    "agent"
  ],
  "license": "MIT",
  "author": "AGSQ11"
}
